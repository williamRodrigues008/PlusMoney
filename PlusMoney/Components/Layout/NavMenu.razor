<div class="top-row ps-3 navbar">
    <div class="container-fluid">
        <h3 class="text-center fonteAzul">Plus Money</h3>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/home" Match="NavLinkMatch.All">
                <span class="text-light"><i class="bi bi-house-heart text-center icones" aria-hidden="true"></i> Home</span>
            </NavLink>

        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="usuario" Match="NavLinkMatch.All">
                <span class="text-light text-center"><i class="bi bi-person-add text-center icones" aria-hidden="true"></i> Usuário</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="login" Match="NavLinkMatch.All">
                <span class="text-light text-center"><i class="bi bi-person-circle text-center icones" aria-hidden="true"></i> Login</span>
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
